{:paths ["src" "test" "."]
 :tasks
 {test {:doc "Run all six suites (core + anthropic + openai + gemini + mcp + fusion) on
             Babashka — each in its own bb subprocess, since -main calls
             System/exit unconditionally and would otherwise kill the
             process before the next suite ran"
        :task (let [c (shell {:continue true} "bb" "test-core")
                    a (shell {:continue true} "bb" "test-anthropic")
                    o (shell {:continue true} "bb" "test-openai")
                    g (shell {:continue true} "bb" "test-gemini")
                    m (shell {:continue true} "bb" "test-mcp")
                    f (shell {:continue true} "bb" "test-fusion")]
                (System/exit (if (every? zero? [(:exit c) (:exit a) (:exit o) (:exit g) (:exit m) (:exit f)]) 0 1)))}
  test-core      {:doc  "Run the core suite (http, sse, ...) on Babashka"
                  :task (exec 'tools.agents.core.test-runner/-main)}
  test-anthropic {:doc  "Run the anthropic suite on Babashka"
                  :task (exec 'tools.agents.anthropic.test-runner/-main)}
  test-openai    {:doc  "Run the openai suite on Babashka"
                  :task (exec 'tools.agents.openai.test-runner/-main)}
  test-gemini    {:doc  "Run the gemini suite on Babashka"
                  :task (exec 'tools.agents.gemini.test-runner/-main)}
  test-mcp       {:doc  "Run the mcp suite on Babashka"
                  :task (exec 'tools.agents.mcp.test-runner/-main)}
  test-fusion    {:doc  "Run the fusion suite on Babashka"
                  :task (exec 'tools.agents.fusion.test-runner/-main)}}}
